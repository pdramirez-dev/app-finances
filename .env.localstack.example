# Credenciales dummy aceptadas por LocalStack. Nunca usar en AWS real.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566

# LocalStack requiere un token de la cuenta localstack.cloud.
LOCALSTACK_AUTH_TOKEN=replace_with_localstack_token
LOCALSTACK_SERVICES=dynamodb,s3,lambda,iam,sts
LOCALSTACK_DEBUG=0
LOCALSTACK_PERSISTENCE=0
LOCALSTACK_ENABLE_COGNITO=false

# PostgreSQL local sustituye Aurora durante el desarrollo.
DATABASE_URL=postgresql://app:app@localhost:5432/app_finances

# Los IDs se generan al arrancar y se escriben en
# .localstack/app-finances.env.
AUTH_COGNITO_ENDPOINT_URL=http://localhost:4566
AUTH_COGNITO_USER_POOL_ID=local-cognito-disabled
AUTH_COGNITO_USER_POOL_CLIENT_ID=local-cognito-disabled
AUTH_COGNITO_SECRET=
LOCAL_COGNITO_EMAIL=admin@app-finances.local
LOCAL_COGNITO_PASSWORD=LocalPass123!

# El frontend usa su transporte demo mientras AppSync/RDS no estén
# conectados al entorno local.
DEV_AUTH_BYPASS=true
AUTH_SECRET=local-only-auth-secret-change-me
AUTH_URL=http://localhost:3000
APP_ACCOUNT_ID=00000000-0000-4000-8000-000000000001
